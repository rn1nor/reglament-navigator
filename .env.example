# Настройки навигатора. Файл необязателен: без него всё работает со значениями по умолчанию.
# Чтобы изменить настройку, скопируйте файл в .env и раскомментируйте нужную строку.
# Docker: файл .env читает docker compose. Запуск без Docker: его подхватывают цели make (make ui-org, make api и другие).
# Полный список переменных и значений по умолчанию: navigator/config.py.

# ---------------------------------------------------------------- поиск
# auto | on | off | hash. В Docker значение auto уточняется при запуске: по памяти и по наличию моделей.
#   полный режим (BM25 + плотный поиск BGE-M3 + реранкер): интерфейсу нужно от 9,5 ГБ памяти Docker
#   BM25 + реранкер: от 4,5 ГБ (на тест-наборах качество то же, что в полном режиме)
#   меньше 4,5 ГБ: BM25 без моделей
#NAVIGATOR_USE_DENSE=auto
#NAVIGATOR_USE_RERANKER=auto
# Облегчённый режим без моделей и без скачиваний:
#NAVIGATOR_USE_DENSE=off
#NAVIGATOR_USE_RERANKER=off
# Сколько кандидатов передаётся реранкеру и сколько пунктов попадает в ответ
#NAVIGATOR_TOP_K_CANDIDATES=40
#NAVIGATOR_TOP_K_FINAL=8
# Порог отказа по оценке реранкера
#NAVIGATOR_GATE_MIN_RERANK=0.2

# ---------------------------------------------------------------- только Docker
# 1: скачать модели поиска в образ при сборке (около 4,6 ГБ; после сборки интернет не нужен). 0: не скачивать,
# тогда модели скачаются при первом запуске в том models, а без сети сервис поднимется в режиме BM25.
#PRELOAD_MODELS=1
# Зеркало Hugging Face, если основной адрес недоступен
#HF_ENDPOINT=https://hf-mirror.com
# Порты и адрес на хосте (127.0.0.1: сервис виден только с этой машины)
#NAVIGATOR_UI_PORT=8501
#NAVIGATOR_API_PORT=8000
#NAVIGATOR_BIND=0.0.0.0
# Пороги памяти (МБ) для выбора режима поиска и предел ожидания загрузки одной модели (секунды)
#NAVIGATOR_MEM_FULL_MB=9500
#NAVIGATOR_MEM_RERANK_MB=4500
#NAVIGATOR_MODEL_TIMEOUT=2400
# База знаний и папка документов внутри контейнера (каталог ./data хоста примонтирован как /app/data)
#NAVIGATOR_KB=/app/data/kb/org
#NAVIGATOR_RAW=/app/data/raw/org

# ---------------------------------------------------------------- распознавание сканов
# auto (tesseract, на macOS затем Vision) | tesseract | ocrmac | easyocr | off
#NAVIGATOR_OCR=auto

# ---------------------------------------------------------------- модель ответа
# Без модели (по умолчанию) ответ собирается из дословных положений документов: поиск, проверка цитат и отказ работают полностью.
# anthropic | openai_compat | mock | auto (anthropic при наличии ключа, иначе без модели)
#NAVIGATOR_LLM=auto
# Внешний API допустим только для открытых баз: для закрытой базы (policy.json) он отключается автоматически.
#ANTHROPIC_API_KEY=
#NAVIGATOR_MODEL_GENERATOR=claude-opus-5-5
#NAVIGATOR_MODEL_EXTRACTOR=claude-opus-5-5
#NAVIGATOR_MODEL_JUDGE=claude-haiku-5-5
# Локальная или российская модель через OpenAI-совместимый адрес (vLLM, LiteLLM, шлюз GigaChat или YandexGPT).
# Без Docker: http://localhost:8001/v1. Из контейнера сервер на хосте виден как host.docker.internal.
#NAVIGATOR_LLM=openai_compat
#NAVIGATOR_OPENAI_BASE_URL=http://host.docker.internal:8001/v1
#NAVIGATOR_OPENAI_MODEL=Qwen/Qwen3-32B
#NAVIGATOR_OPENAI_API_KEY=EMPTY
# Кэш ответов модели (воспроизводимые демонстрации и прогоны): 1 | 0
#NAVIGATOR_LLM_CACHE=1
# 1: разрешить внешнюю модель для базы, помеченной закрытой (только если документы действительно открытые)
#NAVIGATOR_ALLOW_EXTERNAL_LLM=

# ---------------------------------------------------------------- прочее
# Дата «сегодня» для воспроизводимых прогонов, ГГГГ-ММ-ДД
#NAVIGATOR_TODAY=
